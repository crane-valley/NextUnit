<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enforce strict code quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit the whole graph, not just direct references. The SDK default has changed between
         versions, and a vulnerability that only a transitive package carries is the common case. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- NuGet audit findings stay warnings. As errors they fail restore for everyone the moment an
         advisory is published against a package the repository already depends on, including work
         that touches no dependency at all. The Security Scan job fails on what a pull request
         introduces and the nightly Vulnerability Scan fails on what is already here, so the finding
         still blocks something; it just blocks the right thing. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    
    <!-- Generate XML documentation for all projects -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Relax strict checks in Debug builds for faster development iteration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Enforce all checks in Release builds (same as CI/CD) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Shared Package Metadata -->
  <PropertyGroup>
    <Version>4.0.0</Version>
    <Authors>NextUnit Contributors</Authors>
    <Company>NextUnit</Company>
    <Product>NextUnit</Product>
    <PackageTags>testing;test;framework;xunit;tunit;unittest;nextunit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/crane-valley/NextUnit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/crane-valley/NextUnit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2025 NextUnit Contributors</Copyright>
    <PackageReleaseNotes>See https://github.com/crane-valley/NextUnit/blob/main/CHANGELOG.md for release notes.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
