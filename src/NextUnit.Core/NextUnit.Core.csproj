<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NextUnit.Core</AssemblyName>
    <RootNamespace>NextUnit</RootNamespace>

    <!-- Package Information -->
    <PackageId>NextUnit.Core</PackageId>
    <Description>NextUnit is a modern, high-performance test framework for .NET 10+ that combines TUnit's architecture with xUnit's familiar assertions. This package contains the core attributes, assertions, and execution engine.</Description>
    <PackageTags>$(PackageTags);assertions;aot;native-aot;source-generator</PackageTags>

    <!-- NuGet Package Settings -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Expose internal types to related assemblies -->
  <ItemGroup>
    <InternalsVisibleTo Include="NextUnit.TestAdapter" />
    <InternalsVisibleTo Include="NextUnit.Platform" />
    <InternalsVisibleTo Include="NextUnit.Platform.Tests" />
    <InternalsVisibleTo Include="NextUnit.Generator.Tests" />
    <InternalsVisibleTo Include="NextUnit.TestAdapter.Tests" />
    <InternalsVisibleTo Include="NextUnit.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Include analyzers in the package -->
  <ItemGroup>
    <ProjectReference Include="..\NextUnit.Analyzers\NextUnit.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <!-- Public API surface is tracked in PublicAPI.Shipped.txt so a refactor cannot change it silently. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>