<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NextUnit.Generator</AssemblyName>
    <RootNamespace>NextUnit.Generator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Information -->
    <PackageId>NextUnit.Generator</PackageId>
    <Description>Source generator for NextUnit test framework. Provides zero-reflection test discovery via compile-time code generation. Emits test registry with delegate-based method invocation for maximum performance and Native AOT compatibility.</Description>
    <PackageTags>$(PackageTags);sourcegenerator;analyzer;roslyn;aot;codegen</PackageTags>

    <!-- Source Generator Settings -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- RS1032 (diagnostic message punctuation) started applying only because the NEXTUNIT
         descriptors now live in a static table instead of being constructed inline at each report
         site. It is suppressed rather than obeyed: the message texts are a published suppression
         contract that must stay byte-identical, so they cannot be reworded to satisfy the rule.
         RS2008 is no longer suppressed - the release history in AnalyzerReleases.Shipped.md was
         reconstructed by finding, for each NEXTUNIT rule ID, the earliest release tag whose tree
         contains it. -->
    <NoWarn>$(NoWarn);NU5128;RS1032</NoWarn>
    <!-- Disable AOT for netstandard2.0 analyzer project -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Linked source, not a project reference: the generator ships as a single self-contained
       analyzer assembly, so the shared code is compiled into it rather than added as a dependency.
       NextUnit.Shared is linked into NextUnit.Core as well, which is what keeps the compile-time and
       discovery-time expansion caps from drifting apart. -->
  <ItemGroup>
    <Compile Include="..\NextUnit.CodeAnalysis.Shared\*.cs" LinkBase="CodeAnalysisShared" />
    <Compile Include="..\NextUnit.Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Public API surface is tracked in PublicAPI.Shipped.txt so a refactor cannot change it silently. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Analyzer release tracking (RS2000-RS2008): the shipped file records which package version
       first shipped each NEXTUNIT rule, so a new rule cannot be added without declaring it. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>