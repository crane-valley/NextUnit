<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The NextUnit meta-package brings the runtime, the source generator, the analyzers, and the
         Microsoft.Testing.Platform entry point, so no other package reference is needed. -->
    <PackageReference Include="NextUnit" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NextUnit" />
  </ItemGroup>

</Project>
