<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <!-- NextUnit.Generator is referenced as a library, not as an analyzer: the samples are compiled
         in-process through a GeneratorDriver, which needs the generator type at run time. -->
    <ProjectReference Include="..\..\src\NextUnit.Core\NextUnit.Core.csproj" />
    <ProjectReference Include="..\..\src\NextUnit.Generator\NextUnit.Generator.csproj" />
    <ProjectReference Include="..\..\src\NextUnit.Platform\NextUnit.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The guides are the compile input, so they have to reach the test output directory. -->
    <None Include="..\..\docs\MIGRATION_FROM_NUNIT.md" Link="Guides\MIGRATION_FROM_NUNIT.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\MIGRATION_FROM_MSTEST.md" Link="Guides\MIGRATION_FROM_MSTEST.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
