<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(PublishAotPackageSmoke)' == 'true'">true</PublishAot>
    <SelfContained Condition="'$(PublishAotPackageSmoke)' == 'true'">true</SelfContained>
    <DefineConstants Condition="'$(UseLocalNextUnitPackage)' == 'true'">$(DefineConstants);NEXTUNIT_LOCAL_PACKAGE</DefineConstants>
    <!-- The default must stay a version already published to nuget.org: GitHub's
         automatic dependency submission restores this project without the local
         package feed, so referencing the in-repo $(NextUnitVersion) unconditionally
         breaks that job between a release merge and NuGet indexing. CI opts into
         the freshly packed version via -p:UseLocalNextUnitPackage=true. -->
    <NextUnitPackageSmokeVersion Condition="'$(UseLocalNextUnitPackage)' == 'true'">$(NextUnitVersion)</NextUnitPackageSmokeVersion>
    <NextUnitPackageSmokeVersion Condition="'$(NextUnitPackageSmokeVersion)' == ''">2.0.0</NextUnitPackageSmokeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NextUnit" VersionOverride="$(NextUnitPackageSmokeVersion)" />
  </ItemGroup>
</Project>
